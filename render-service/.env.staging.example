# Copy this file to .env.staging on the private staging host.
# Replace the placeholder with: openssl rand -hex 32
RENDER_API_TOKEN=REPLACE_WITH_64_HEX_CHARACTERS
# Exact HTTPS origin serving the PWA; no path and no trailing slash.
ALLOWED_ORIGIN=https://your-private-staging-pwa.example
# Initial conservative limits. Adjust only after measuring the host.
DARK_VIDEO_MAX_STORAGE_BYTES=1073741824
DARK_VIDEO_MAX_OUTPUT_BYTES=536870912
DARK_VIDEO_RATE_LIMIT=30
DARK_VIDEO_CREATE_RATE_LIMIT=5
